---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FormattedDate from "../components/FormattedDate.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { SITE_TITLE } from "../consts";

type Props = CollectionEntry<"blog">["data"] & { headings: MarkdownHeading[] };

const { title, description, pubDate, updatedDate, headings } = Astro.props;
const tocHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
const hasToc = tocHeadings.length >= 2;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead
      title={`${title} — ${SITE_TITLE}`}
      description={description}
    />
  </head>
  <body class="blog-body">
    <SiteNav />
    <main class:list={["post-main", { "post-main-with-toc": hasToc }]}>
      <article class="post">
        <a href="/blog" class="post-back">← All writing</a>
        <p class="post-meta">
          <FormattedDate date={pubDate} />
          {
            updatedDate && (
              <span class="post-updated">
                {" "}
                · Updated <FormattedDate date={updatedDate} />
              </span>
            )
          }
        </p>
        <h1 class="post-title">{title}</h1>
        {
          hasToc && (
            <details class="toc-mobile">
              <summary>On this page</summary>
              <TableOfContents headings={tocHeadings} />
            </details>
          )
        }
        <div class="prose">
          <slot />
        </div>
      </article>
      {
        hasToc && (
          <aside class="post-sidebar">
            <TableOfContents headings={tocHeadings} />
          </aside>
        )
      }
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .blog-body {
    margin: 0;
    background: var(--cloud);
    font-family: var(--font-body);
  }
  .blog-body a:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }
  .post-main {
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(40px, 8vw, 72px) 24px clamp(48px, 9vw, 88px);
  }
  .post-back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--grey-500);
    text-decoration: none;
    margin-bottom: 28px;
  }
  .post-back:hover {
    color: var(--signal);
  }
  .post-meta {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--grey-500);
    margin: 0;
  }
  .post-title {
    font-family: var(--font-heading);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
    font-size: clamp(30px, 6vw, 44px);
    color: var(--terminal);
    margin: 10px 0 0;
  }
  .post-sidebar {
    display: none;
  }
  .toc-mobile {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 12px 16px;
    margin: 28px 0 0;
  }
  .toc-mobile summary {
    font-family: var(--font-mono);
    font-size: 13px;
    cursor: pointer;
  }
  /* The summary already says "On this page" — drop the inner eyebrow. */
  .toc-mobile :global(.toc-eyebrow) {
    display: none;
  }
  .prose {
    margin-top: 36px;
  }
  @media (min-width: 1024px) {
    .post-main-with-toc {
      display: grid;
      grid-template-columns: minmax(0, 720px) 220px;
      gap: 48px;
      max-width: 1036px;
    }
    .post-sidebar {
      display: block;
      position: sticky;
      top: 92px;
      align-self: start;
      max-height: calc(100vh - 92px - 24px);
      overflow-y: auto;
    }
    .toc-mobile {
      display: none;
    }
  }
</style>
