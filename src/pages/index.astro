---
import BaseHead from "../components/BaseHead.astro";
import SiteNav from "../components/SiteNav.astro";
import PersonalHero from "../components/PersonalHero.astro";
import BeliefBlock from "../components/BeliefBlock.astro";
import CareerTimeline from "../components/CareerTimeline.astro";
import PersonalContact from "../components/PersonalContact.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="pn-body">
    <SiteNav />
    <main>
      <PersonalHero />
      <BeliefBlock />
      <CareerTimeline />
      <PersonalContact />
    </main>
  </body>
</html>

<style is:global>
  .pn-body {
    margin: 0;
    background: var(--terminal);
    font-family: var(--font-body);
  }
  .pn-body a:hover {
    opacity: 0.78;
  }
  /* WCAG 2.4.7 — explicit keyboard focus indicator. A double ring (gold
     outline + offset) stays visible on both the dark hero/contact surfaces
     and the light cloud path surface. */
  .pn-body a:focus-visible,
  .pn-body button:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
</style>
