---
import BaseHead from "../../components/BaseHead.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={`Writing — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="blog-body">
    <SiteNav />
    <main class="blog-main">
      <header class="blog-head">
        <p class="blog-eyebrow">Writing</p>
        <h1 class="blog-title">From the Blog.</h1>
        <p class="blog-intro">
          Notes on front-end engineering, React, and whatever I've been figuring
          out lately.
        </p>
      </header>

      <ul class="post-list">
        {
          posts.map((post) => (
            <li class="post-item">
              <a href={`/blog/${post.id}/`} class="post-card">
                <div class="post-body">
                  <span class="post-date">
                    <FormattedDate date={post.data.pubDate} />
                  </span>
                  <h2 class="post-heading">{post.data.title}</h2>
                  <p class="post-desc">{post.data.description}</p>
                  <span class="post-more">Read article →</span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .blog-body {
    margin: 0;
    background: var(--cloud);
    font-family: var(--font-body);
  }
  .blog-body a:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }
  .blog-main {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(48px, 9vw, 80px) 24px clamp(48px, 9vw, 88px);
  }
  .blog-eyebrow {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.04em;
    color: var(--signal);
    margin: 0;
  }
  .blog-title {
    font-family: var(--font-heading);
    font-weight: 800;
    letter-spacing: -0.025em;
    font-size: clamp(34px, 8vw, 52px);
    color: var(--terminal);
    margin: 10px 0 0;
  }
  .blog-intro {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.6;
    color: var(--grey-600);
    max-width: 60ch;
    margin: 14px 0 0;
  }
  .post-list {
    list-style: none;
    margin: clamp(36px, 6vw, 60px) 0 0;
    padding: 0;
  }
  .post-item + .post-item {
    border-top: 1px solid var(--border-subtle);
  }
  .post-card {
    display: block;
    padding: 28px 0;
    text-decoration: none;
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--grey-500);
  }
  .post-heading {
    font-family: var(--font-heading);
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 22px;
    line-height: 1.2;
    color: var(--terminal);
    margin: 8px 0 0;
    transition: color 120ms ease;
  }
  .post-card:hover .post-heading {
    color: var(--signal);
  }
  .post-desc {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--grey-600);
    margin: 10px 0 0;
    max-width: 64ch;
  }
  .post-more {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--signal);
    margin: 14px 0 0;
  }
</style>
