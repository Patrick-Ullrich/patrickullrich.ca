---
// Personal site — hero. Eyebrow + display headline + short bio + real photo.
import { Image } from "astro:assets";
import heroPhoto from "../assets/patrick.jpg";
---

<header id="about" class="pn-hero-section">
  <div class="pn-hero">
    <div>
      <div class="pn-hero-eyebrow">VP of Engineering · Offstreet</div>
      <h1 class="pn-hero-h1">Hi, I'm Patrick.</h1>
      <p class="pn-hero-bio">
        VP of Engineering at Offstreet and founder of <strong>Kollektiv
          Software Studio</strong>. Full-stack by background, React &amp; Node.js
        by trade. Originally from Bavaria, in Canada since 2013 — I lead teams
        building modern web platforms that <em>move fast without the
          unnecessary complexity</em>.
      </p>
      <div class="pn-hero-buttons">
        <a href="#contact" class="pn-btn-primary">
          Get in touch
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="#path" class="pn-btn-secondary">See the path</a>
      </div>
    </div>

    <div class="pn-hero-photo-wrap">
      <div class="pn-hero-photo">
        <Image
          src={heroPhoto}
          alt="Patrick Ullrich"
          widths={[440, 880]}
          sizes="(max-width: 820px) 88vw, 396px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <span class="pn-hero-square" aria-hidden="true"></span>
    </div>
  </div>
</header>

<style>
  .pn-hero-section {
    background: var(--dark-surface);
  }
  .pn-hero {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(56px, 11vw, 92px) 24px clamp(48px, 10vw, 88px);
    display: grid;
    grid-template-columns: 1.3fr 0.9fr;
    gap: 60px;
    align-items: center;
  }
  .pn-hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.04em;
    color: var(--signal-on-dark);
  }
  .pn-hero-h1 {
    font-family: var(--font-heading);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.04;
    font-size: clamp(34px, 9vw, 60px);
    overflow-wrap: break-word;
    margin: 20px 0 0;
    color: var(--cloud);
  }
  .pn-hero-bio {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.6;
    color: rgba(246, 246, 247, 0.8);
    margin: 22px 0 0;
    max-width: 54ch;
  }
  .pn-hero-bio strong {
    color: var(--cloud);
    font-weight: 700;
  }
  .pn-hero-bio em {
    font-style: normal;
    color: var(--signal-on-dark);
  }
  .pn-hero-buttons {
    display: flex;
    gap: 12px;
    margin-top: 30px;
    flex-wrap: wrap;
  }
  .pn-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 15px;
    color: var(--accent-ink);
    background: var(--accent);
    padding: 13px 22px;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }
  .pn-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 15px;
    color: var(--cloud);
    background: transparent;
    border: 1px solid rgba(246, 246, 247, 0.3);
    padding: 12px 22px;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }
  .pn-hero-photo-wrap {
    position: relative;
  }
  .pn-hero-photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(246, 246, 247, 0.16);
    background: var(--grey-700);
  }
  .pn-hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pn-hero-square {
    position: absolute;
    left: -10px;
    bottom: -10px;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    z-index: -1;
  }
  @media (max-width: 820px) {
    .pn-hero {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
